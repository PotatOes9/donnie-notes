{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "next/navigation": [
        "./src/router.tsx"
      ]
    }
  },
  "include": [
    "src",
    "lib",
    "components",
    "vite.config.ts",
    "worker"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".render",
    "components/ui"
  ]
}
