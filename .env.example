# Save these in GitHub Actions Secrets / Variables, never in the repository.
# NOTION_TOKEN= (secret; required)
# NOTION_ARTICLES_ID= (secret; database or data-source ID, required)
# NOTION_COPY_SOURCE_ID= (secret; website settings data-source ID, required)
# PAGES_BASE_PATH=/repository-name/ (variable; / for owner.github.io or custom domain)
# SITE_URL=https://owner.github.io/repository-name (variable)
# ANALYTICS_ORIGIN=https://your-worker.workers.dev (variable; optional until migrated)
# REPOSITORY_URL=https://github.com/owner/repository-name (variable)
